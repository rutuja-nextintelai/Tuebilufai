# nginx configuration for the built site.
# ${PORT} is filled in by the nginx image's entrypoint from the PORT environment variable,
# which Cloud Run sets (8080 by default). Everything else is plain nginx syntax.

# Cache policy by request path. Vite fingerprints bundled files (for example index-BxK3jD2a.js),
# so those can be cached for a year. HTML is always revalidated so a new deploy shows up at once.
# Files copied from public/ are not fingerprinted, so they get a short cache lifetime.
map $uri $cache_control {
    default                                      "public, max-age=86400";
    "~*\.html$"                                  "no-cache";
    "~*-[A-Za-z0-9_-]{8}\.(js|css|woff2?|ttf)$"  "public, max-age=31536000, immutable";
}

server {
    listen ${PORT};
    server_name _;
    server_tokens off;

    root /usr/share/nginx/html;
    index index.html;

    # Compress text assets. Cloud Run does not do this on your behalf.
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/javascript application/javascript application/json
               application/manifest+json image/svg+xml application/xml;

    add_header Cache-Control $cache_control always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Strict-Transport-Security "max-age=31536000" always;

    # Cheap endpoint for uptime checks and Cloud Run probes. (/healthz is reserved by Google's frontend.)
    location = /health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Static files: serve them if they exist, otherwise answer with a real 404
    location ~* \.(?:js|css|map|json|png|jpg|jpeg|gif|svg|webp|avif|ico|mp4|webm|woff2?|ttf|txt|xml)$ {
        try_files $uri =404;
    }

    # Everything else is a client-side route handled by React Router
    location / {
        try_files $uri /index.html;
    }
}
